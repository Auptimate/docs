{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Auptimate Client Portal",
  "colors": {
    "primary": "#E61B72",
    "light": "#F28DB8",
    "dark": "#C11760"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "getting-started/sign-in"
            ]
          },
          {
            "group": "Deals",
            "pages": [
              "deals/overview",
              "deals/create",
              "deals/manage",
              "deals/investors",
              "deals/compliance",
              "deals/public-page"
            ]
          },
          {
            "group": "Documents",
            "pages": [
              "documents/overview",
              "documents/sign"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/profile",
              "account/entities"
            ]
          },
          {
            "group": "Funds",
            "pages": [
              "funds/overview"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/help-center"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "groups": [
          {
            "group": "Development",
            "pages": [
              "development/setup",
              "development/architecture",
              "development/conventions"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/Auptimate-logo-RGB_icon.jpg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://app.auptimate.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
    "claude"
  ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/auptimate"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "fonts": {
    "family": "Poppins"
  }
}
